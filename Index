<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
<title>Smoothie Lab - Menú</title>

<style>
/* --- Reset Básico para evitar dobles scrolls --- */
html, body { 
    margin: 0; padding: 0; height: 100%; width: 100%;
    overflow: hidden; background: #000; 
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
    overscroll-behavior: none;
}

/* --- Contenedor de Video optimizado para LG webOS --- */
#video-container {
    position: fixed; top: 0; left: 0;
    width: 100vw; height: 100vh; z-index: 0;
    background: black;
}
video#bg-video { 
    width: 100%; height: 100%; object-fit: cover; 
}

/* --- Capa que contendrá la liga externa integrada --- */
#menu-overlay {
    position: fixed; top: 0; left: 0;
    width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.95); 
    z-index: 10; display: none;
    flex-direction: column;
    box-sizing: border-box;
}

/* --- Iframe para mostrar tu catálogo dentro de la página --- */
#catalog-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: #fff;
}

/* --- Botón Flotante de Cierre (Para regresar al video) --- */
#close-button {
    position: fixed; bottom: 30px; left: 50%;
    transform: translateX(-50%);
    padding: 18px 45px; font-size: 1.6rem;
    background: #fff; color: #000;
    border: none; border-radius: 50px; cursor: pointer;
    z-index: 11; box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    font-weight: bold;
}

/* --- Botón de Apertura Inicial --- */
#open-button { 
    position: fixed; bottom: 40px; right: 40px;
    padding: 35px 65px; font-size: 2.8rem;
    border: none; border-radius: 25px;
    background-color: rgba(255,255,255,0.95); color: black;
    font-weight: bold; cursor: pointer;
    animation: pulse-tle 2s infinite; z-index: 5;
    box-shadow: 0 15px 40px rgba(0,0,0,0.6);
}
@keyframes pulse-tle { 0% { transform: scale(1); } 50% { transform: scale(1.04); } 100% { transform: scale(1); } }
</style>
</head>
<body>

<!-- Video en bucle con atributos de seguridad para LG -->
<div id="video-container">
    <video id="bg-video" autoplay muted loop playsinline preload="auto">
        <source src="smoothie-lab-video.mp4" type="video/mp4">
        Tu navegador no soporta video.
    </video>
</div>

<!-- Capa desplegable con tu enlace incrustado y el botón de cerrar -->
<div id="menu-overlay">
    <iframe id="catalog-frame" src="https://linkdenegocio.mx/@smoothielab/catalogo" title="Catálogo Smoothie Lab"></iframe>
    <button id="close-button" onclick="closeMenuManual()">X Cerrar Menú</button>
</div>

<!-- Botón inicial de apertura -->
<button id="open-button" onclick="openMenu()">Ver Menu</button>

<script>
const openBtn = document.getElementById('open-button');
const menuOverlay = document.getElementById('menu-overlay');
const bgVideo = document.getElementById('bg-video');

window.addEventListener('load', () => {
    bgVideo.play().catch(e => console.log("Autoplay:", e));
});

function openMenu() {
    menuOverlay.style.display = 'flex';
    openBtn.style.display = 'none';
}

function closeMenuManual() {
    menuOverlay.style.display = 'none';
    openBtn.style.display = 'block';
    bgVideo.play().catch(e => console.log("Play al cerrar:", e));
}
</script>

</body>
</html>
